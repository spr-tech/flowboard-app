// Flowboard data model. The plan for this file is docs/plan/03-data-model.md.

generator client {
  provider        = "prisma-client-js"
  output          = "../src/lib/generated/prisma"
  // Lets us declare "at most one done column per project" as a partial unique index.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ProjectRole {
  OWNER
  MEMBER
}

// Colour keys, not hex. The frontend maps each key to a token and a readable text colour.
enum ProjectColour {
  vermilion
  espresso
  lime
  blue
  teal
  plum
  amber
  rose
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// ─── Users and Auth.js ───────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  name              String?
  // Always stored lowercase.
  email             String    @unique
  // Required by the Auth.js Prisma adapter.
  emailVerified     DateTime?
  // Null for GitHub-only users.
  passwordHash      String?
  image             String?
  // Sessions issued before this moment are treated as signed out.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts            Account[]
  memberships         ProjectMember[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  createdColumns      Column[]             @relation("ColumnCreator")
  sentInvites         Invite[]
  passwordResetTokens PasswordResetToken[]
  activities          Activity[]
}

// Auth.js adapter table: links a GitHub login to a User.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // Only the hash is stored, never the token itself.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id                   String        @id @default(cuid())
  name                 String
  // Optional, at most 200 characters (checked by the API); null when empty.
  description          String?
  colour               ProjectColour @default(vermilion)
  // Whether members (not just the owner) may add columns, and how many member-created columns
  // the project may have in total (1 to 10, checked by the API).
  membersCanAddColumns Boolean       @default(false)
  memberColumnLimit    Int           @default(3)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  members    ProjectMember[]
  columns    Column[]
  tasks      Task[]
  invites    Invite[]
  activities Activity[]
}

// Ownership lives only here, in role.
model ProjectMember {
  userId       String
  projectId    String
  role         ProjectRole @default(MEMBER)
  joinedAt     DateTime    @default(now())
  // Per user. Null = not pinned. Pinned projects sort by this, oldest pin first.
  pinnedAt     DateTime?
  // When this user last opened the project (written at most once a minute). Drives the
  // sidebar's "recent" slots; null falls back to joinedAt.
  lastOpenedAt DateTime?
  // This member's own column order: a JSON list of column ids. Null = follow the team order
  // (Column.position). The owner never has one: the owner's drags change the team order.
  columnOrder  Json?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model Invite {
  id          String    @id @default(cuid())
  projectId   String
  // Always stored lowercase.
  email       String
  // Only the hash is stored. Resending replaces it (and expiresAt) on the same row.
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  // Set when the owner cancels it. The row stays, so the link can say it was cancelled.
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation(fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([projectId, email])
}

// ─── Board ───────────────────────────────────────────────────────────────────

model Column {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  // Spaced floats (1000, 2000, ...), like tasks.
  position    Float
  // Exactly one per project. The index below guarantees "at most one";
  // services guarantee "at least one".
  isDone      Boolean  @default(false)
  // Who added it: the owner, or a member when members may add columns (counts toward the limit).
  createdById String
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ColumnCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks     Task[]

  @@unique([projectId], map: "Column_one_done_per_project", where: { isDone: true })
  @@index([projectId, position])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  columnId    String
  title       String
  description String?
  priority    Priority  @default(MEDIUM)
  // Spaced floats, computed only on the server.
  position    Float
  // A calendar day, no time.
  dueDate     DateTime? @db.Date
  assigneeId  String?
  createdById String
  // Set when the task enters the done column, cleared when it leaves.
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column     Column     @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee   User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy  User       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  activities Activity[]

  @@index([columnId, position])
  @@index([projectId])
  @@index([assigneeId])
}

// ─── Sign-in rate limit ──────────────────────────────────────────────────────

/// One failed email-and-password sign-in. At most 5 per email in 15 minutes (milestone 9).
/// Not linked to User: unknown emails are counted exactly like real ones.
model SignInAttempt {
  id        String   @id @default(cuid())
  // Always stored lowercase.
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// ─── Activity ────────────────────────────────────────────────────────────────

model Activity {
  id        String   @id @default(cuid())
  projectId String
  actorId   String
  // Dotted action name, e.g. "task.moved". Allowed values live in a TypeScript type.
  action    String
  // Kept when the task is deleted; meta still holds its title.
  taskId    String?
  // e.g. { "from": "In progress", "to": "Done" }
  meta      Json?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([taskId])
}
