# Copy to .env and fill in. Never commit .env.

# Database: the new Neon project's DEV branch (never production).
# Pooled connection, used by the app.
DATABASE_URL=
# Direct connection, used by the Prisma CLI (migrations, seed).
DIRECT_URL=
# db:seed and db:reset wipe the database; they refuse to run unless this is "true". Local only.
ALLOW_DB_RESET=

# Auth.js. Generate a secret with: pnpm dlx auth secret
AUTH_SECRET=
# Needed for `pnpm start` locally (Vercel sets it automatically).
AUTH_TRUST_HOST=true

# GitHub OAuth app (local one: callback http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email through Gmail SMTP. EMAIL_PASS is a Google "App password", not your Google password.
# Leave both empty locally to print emails to the server console instead of sending them.
EMAIL_USER=
EMAIL_PASS=

# Public address used in email links, social cards, robots.txt and the sitemap. Optional with `pnpm dev` (defaults to http://localhost:3000)
# and on Vercel previews (defaults to the branch URL). Required in production, including
# `pnpm start` locally: set it to http://localhost:3000 there.
APP_URL=
